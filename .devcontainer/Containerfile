FROM cgr.dev/chainguard/wolfi-base:latest@sha256:5172a213d2bba8b1c9ca11957db65562b52b0f9844583a0347318ea5fd8e3aa5

USER 0:0

SHELL ["/bin/ash", "-eo", "pipefail", "-c"]

RUN apk add --no-cache \
    bash=5.3-r15 \
    crun=1.30.1-r0 \
    curl=8.23.0-r4 \
    ca-certificates=20261020-r1 \
    ca-certificates-bundle=20261020-r1 \
    fuse-overlayfs=1.18-r2 \
    git=2.56.1-r2 \
    libcap-utils=2.78-r5 \
    libatomic=16.2.0-r5 \
    libstdc++=16.2.0-r5 \
    podman=6.0.0-r4 \
    shadow=4.20.4-r0 \
    shadow-subids=4.20.4-r0 \
    slirp4netns=1.3.7-r1 \
    tzdata=2026f-r1

RUN groupadd -g 1000 dev \
    && useradd -u 1000 -g 1000 -m -s /bin/bash dev

RUN printf 'dev:1:999\ndev:1001:64535\n' > /etc/subuid \
    && printf 'dev:1:999\ndev:1001:64535\n' > /etc/subgid

RUN chmod 0755 /usr/bin/newuidmap /usr/bin/newgidmap \
    && setcap cap_setuid=ep /usr/bin/newuidmap \
    && setcap cap_setgid=ep /usr/bin/newgidmap

RUN mkdir -p /etc/containers /usr/local/bin \
    && printf '[storage]\ndriver = "overlay"\n\n[storage.options]\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\nmountopt = "nodev,fsync=0"\nignore_chown_errors = "true"\n' > /etc/containers/storage.conf \
    && printf '[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\nruntime = "crun"\n[network]\ndefault_rootless_network_cmd = "slirp4netns"\n' > /etc/containers/containers.conf \
    && printf '[install]\nminimumReleaseAge = 0\n' > /etc/bunfig.toml

ENV MISE_VERSION=2026.11.14

RUN curl -fsSL https://mise.run | MISE_VERSION="v${MISE_VERSION}" MISE_INSTALL_PATH=/usr/local/bin/mise sh \
    && test -x /usr/local/bin/mise

ENV _CONTAINERS_USERNS_CONFIGURED=""
ENV BUN_SYSTEM_CONFIG=/etc/bunfig.toml
ENV MISE_TRUSTED_CONFIG_PATHS=/workspaces/glance:/workspaces
ENV PATH=/home/dev/.local/share/mise/shims:${PATH}

USER 1000:1000
WORKDIR /workspaces
